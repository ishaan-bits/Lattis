rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile docs: owner-only read/write; uid must match the doc id.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Uniqueness index: public read so signup can check before Auth create;
    // first authenticated writer wins (setDoc on existing doc = update = denied).
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // Projects: only the owner can read or mutate their docs.
    match /projects/{projectId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Canvas notes: gated by ownership of the parent project doc.
    match /projects/{projectId}/nodes/{nodeId} {
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
        && request.resource.data.id == nodeId
        && request.resource.data.type == 'text'
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 50000
        && request.resource.data.color is string
        && request.resource.data.x is number
        && request.resource.data.y is number;
    }

    // Canvas edges: gated by ownership of the parent project doc.
    match /projects/{projectId}/edges/{edgeId} {
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
        && request.resource.data.id == edgeId
        && request.resource.data.from is string
        && request.resource.data.to is string
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.type in ['supports', 'depends', 'contradicts', 'reference', 'inspiration'];
    }

    // Threads: same owner-gated shape as projects.
    match /threads/{threadId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Thread messages: gated by ownership of the parent thread doc.
    match /threads/{threadId}/messages/{messageId} {
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/threads/$(threadId)).data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/threads/$(threadId)).data.ownerId == request.auth.uid
        && request.resource.data.role in ['user', 'assistant']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 20000;
      allow update: if false;
    }
  }
}
